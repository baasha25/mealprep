# Copy to .env and fill in. NEVER commit real secrets.

# Postgres connection string (local, Neon, or Supabase)
DATABASE_URL="postgresql://user@localhost:5432/prepflow_dev?schema=public"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Clerk auth — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# Stripe (test mode; Connect for platform payments)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_CLIENT_ID=""

# Email — Resend (https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM=""

# Background jobs — Inngest
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Invoice scanning (Pro feature) — Claude vision reads supplier invoices
ANTHROPIC_API_KEY=""

# Scheduled notifications — shared secret the cron must send to /api/cron/notifications
CRON_SECRET=""

# Platform super-admins (comma-separated) — can access /admin across all tenants
ADMIN_EMAILS=""

# Live sales demo (/demo/[rep] → "Explore the app"). BOTH must be set to open the
# demo door; leave blank to keep it shut. DEMO_SECRET signs the demo-session
# cookie (use a long random string); DEMO_PASSCODE is what reps type to enter.
DEMO_SECRET=""
DEMO_PASSCODE=""

# Kitchen software billing (platform Stripe account) — from scripts/Stripe dashboard
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_PRO=""
STRIPE_PORTAL_CONFIG_ID=""

# PostHog product + traffic analytics (optional — inert if unset)
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Error monitoring (Sentry) — optional, inert if unset
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Staging only: set to "Staging" to show a "not live" badge. Leave BLANK in production.
NEXT_PUBLIC_ENV_LABEL=""

# Rate limiting (optional but recommended) — Upstash Redis (free tier). Without
# these, rate limiting is inert. Create a DB at console.upstash.com → REST API.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
