// PrepFlow data model (CLAUDE.md §4).
// Conventions:
//  - Multi-tenant: every business is a tenant; all tenant data carries `businessId`.
//  - Money is ALWAYS integer cents (never floats). Field names end in `Cents`.
//  - Percentages/trim are integer basis points (bps): 8% = 800, 12% = 1200.
//  - Quantities (recipe amounts) may be fractional → Float is acceptable (not money).
//  - Order/line snapshots freeze price + name so history never drifts with the live menu.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/* ============================== Enums ============================== */

enum UserRole {
  owner
  staff
}

enum SubStatus {
  active
  paused
  canceled
}

enum SubFrequency {
  weekly
  biweekly
}

enum OrderType {
  subscription
  one_time
  pos
  catering // large/event order created when a catering quote is approved and paid
}

// Catering request lifecycle: requested → quoted → approved (customer said yes;
// order created, awaiting payment) → paid. Owner may decline before payment.
enum CateringStatus {
  requested
  quoted
  approved
  paid
  declined
}

enum OrderStatus {
  pending
  paid
  in_production
  packed
  out_for_delivery
  fulfilled
  canceled
  refunded
}

enum Fulfillment {
  delivery
  pickup
}

enum TicketStatus {
  todo
  cooking
  done
}

enum CouponType {
  percent
  flat
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
  partially_refunded
}

// PrepFlow's own subscription plan for a kitchen (drives the platform fee).
enum BusinessTier {
  starter
  growth
  pro
}

// A kitchen's software-subscription (Option B) status on PrepFlow's own Stripe
// account — separate from the diner→kitchen Connect payments. `none` = never
// subscribed (trialing or lapsed); access is gated by trial + this together.
enum BillingStatus {
  none
  active
  past_due
  canceled
}

// Whether a logged loss is raw inventory or a finished meal.
enum LossKind {
  ingredient
  meal
}

// Why food was lost — the reason code on every LossEvent. Drives the P&L
// breakdown so an owner can see where margin actually leaks.
enum LossReason {
  spoilage // perished in storage (wilted, molded, sprouted, expired on shelf)
  dropped_in_transit // damaged/lost between kitchen and customer
  order_error // wrong/incomplete order remade or written off
  pest // insect/rodent/contamination
  remake // cooked twice for one sale (quality reject, etc.)
  expired // passed its use-by / shelf life
  other
}

/* ============================== Tenant ============================== */

model Business {
  id              String   @id @default(cuid())
  name            String
  slug            String?  @unique // public storefront URL segment: /store/<slug>
  customDomain    String?  @unique // white-label: serve the storefront on the kitchen's own domain
  brandColor      String   @default("#2f4536")
  logoUrl         String?  // merchant logo (Cloudinary secure URL); shown on the storefront header + dashboard. null = leaf + brandColor fallback
  isDemo          Boolean  @default(false) // throwaway sales-demo tenant: read-write but isolated, no real emails/charges, auto-deleted, hidden from /admin + store index
  demoKey         String?  @unique // branded prospect demo: "<rep>:<brand>" — re-entering the same link reuses this tenant instead of minting a new one
  demoExpiresAt   DateTime? // when a kept demo is swept (null = default 24h after creation)
  tier            BusinessTier @default(starter) // PrepFlow plan; sets the platform fee (see src/lib/tiers.ts)
  trialEndsAt     DateTime? // end of the 30-day free trial (null = no trial set, e.g. legacy)
  stripeAccountId String?  @unique // Stripe Connect (Express) connected account
  stripeChargesEnabled Boolean @default(false) // true once Stripe clears them to take payments
  // Software billing (kitchen pays PrepFlow, on the PLATFORM Stripe account):
  billingCustomerId     String? // kitchen's Stripe Customer id for the software subscription
  billingSubscriptionId String? // the software subscription id
  billingStatus         BillingStatus @default(none)
  billingComped         Boolean @default(false) // founding-customer / demo: full access, never charged
  // First-touch acquisition attribution (captured at signup):
  acqSource   String? // e.g. google, instagram, direct, producthunt
  acqMedium   String? // e.g. referral, cpc, social, direct
  acqCampaign String? // utm_campaign
  acqReferrer String? // raw referring URL
  // Partner Program: which partner referred this kitchen (if any). Attribution
  // is first-touch, captured from a ?ref=<code> link at signup.
  referredByPartnerId String?
  // Kitchen's consent to show its monthly sales + order totals (never customer
  // data) to the partner who referred it, on that partner's stats page.
  sharePartnerStats   Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  settings    BusinessSettings?
  users       User[]
  customers   Customer[]
  meals       Meal[]
  ingredients Ingredient[]
  plans       Plan[]
  orders      Order[]
  giftCards   GiftCard[]
  coupons     Coupon[]
  operatingCosts OperatingCost[]
  referredByPartner   Partner? @relation("PartnerReferrals", fields: [referredByPartnerId], references: [id])
  partnerCommissions  PartnerCommission[]
  cateringRequests    CateringRequest[]
}

// ─── Partner Program ────────────────────────────────────────────────────────
// Referral partners (consultants, marketing agencies, kitchen-space operators)
// who send kitchens to PrepFlow via a ?ref=<code> link and earn a recurring
// commission on the software subscription revenue those kitchens pay. Payouts
// go to the partner's own Stripe (Connect Express) account.

model Partner {
  id              String   @id @default(cuid())
  name            String
  email           String
  company         String?
  code            String   @unique // ref link slug, e.g. "cam" → /?ref=cam
  commissionBps   Int      @default(2000) // 20% of the kitchen's subscription payment
  feeShareBps     Int      @default(2000) // 20% of PrepFlow's platform fee on referred kitchens' sales
  activationBonusCents Int @default(15000) // one-time $150 when a referred kitchen pays its first invoice
  stepUpBps       Int      @default(2500) // both recurring shares move to this rate...
  stepUpAtKitchens Int     @default(10)   // ...once this many referred kitchens are live and paying
  status          String   @default("active") // active | paused
  stripeAccountId String?  @unique // Connect Express account that receives transfers
  payoutsEnabled  Boolean  @default(false) // true once Stripe onboarding is complete
  statsToken      String   @unique @default(cuid()) // unguessable token for the partner's read-only stats page
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  referredBusinesses Business[]          @relation("PartnerReferrals")
  commissions        PartnerCommission[]
  payouts            PartnerPayout[]
}

// One accrued commission, created when a referred kitchen's software invoice is
// actually PAID (never on signup or during the free trial). Keyed by the Stripe
// invoice id so a webhook retry can't double-accrue.
model PartnerCommission {
  id              String   @id @default(cuid())
  partnerId       String
  businessId      String
  amountCents     Int // commission owed to the partner
  baseAmountCents Int // the invoice amount it was computed from
  currency        String   @default("cad")
  commissionBps   Int // rate snapshot at accrual time
  kind            String   @default("subscription") // subscription | activation_bonus | platform_fee
  sourceInvoiceId String   @unique // idempotency guard: Stripe invoice id, or "bonus:<biz>" / "fee:<biz>:<YYYY-MM>"
  periodMonth     String // accrual month, e.g. "2026-09"
  status          String   @default("pending") // pending | paid | void
  createdAt       DateTime @default(now())
  paidAt          DateTime?
  payoutId        String?

  partner  Partner        @relation(fields: [partnerId], references: [id])
  business Business       @relation(fields: [businessId], references: [id])
  payout   PartnerPayout? @relation(fields: [payoutId], references: [id])

  @@index([partnerId, status])
  @@index([businessId])
}

// One payout batch = one Stripe transfer to a partner, grouping the commissions
// it settled. Created when a super-admin approves & pays a partner's pending
// balance.
model PartnerPayout {
  id               String   @id @default(cuid())
  partnerId        String
  amountCents      Int
  currency         String   @default("cad")
  stripeTransferId String?
  periodLabel      String // human label for the batch, e.g. "2026-09"
  createdAt        DateTime @default(now())

  partner     Partner             @relation(fields: [partnerId], references: [id])
  commissions PartnerCommission[]
}

model BusinessSettings {
  id         String   @id @default(cuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Pricing / fees (money in cents, rates in basis points)
  subDiscountBps     Int @default(1500) // 15% subscription discount
  deliveryFeeCents   Int @default(499)
  processingFeeCents Int @default(150)
  taxRateBps         Int @default(800) // 8%
  minOrderCents      Int @default(3500)
  minMeals           Int @default(3)
  platformFeeBps     Int @default(150) // PrepFlow platform fee — Starter-tier entry rate 1.5% (Growth 1.25%, Pro 1.0%); config, not hardcoded (§5/§7)

  // Loyalty & referrals
  loyaltyEnabled             Boolean @default(true)
  autoApproveReviews         Boolean @default(false) // publish customer reviews without manual approval
  loyaltyPointsPerDollar     Int     @default(1) // points earned per $1 of subtotal
  loyaltyRedeemCentsPerPoint Int     @default(5) // redemption value: 1 point = 5¢
  referralBonusPoints        Int     @default(100) // points to referrer per successful referral

  // Customer notifications (scheduled reminders)
  notifyCutoff      Boolean @default(true) // "edit your box before cutoff" reminder
  notifyDeliveryDay Boolean @default(true) // "your meals arrive today" email
  // Retention emails (cron: /api/cron/retention)
  notifyAbandoned   Boolean @default(true)  // "finish your order" nudge 2–48h after an unpaid checkout
  notifyWinBack     Boolean @default(false) // "we miss you" after winBackDays without a paid order (no active sub)
  winBackDays       Int     @default(45)
  winBackCouponCode String? // optional code to include in the win-back email
  // Google review requests: a few days after a delivered order, ask the customer
  // for a public review (link the kitchen pastes from Google Business Profile).
  notifyReviewRequest Boolean @default(false)
  googleReviewUrl     String?
  reviewRequestDays   Int     @default(2) // days after delivery to ask
  // Monthly value report: estimated minutes a manual order tally takes (kitchen-adjustable).
  adminMinutesPerOrder Int  @default(4)

  // Catering / large orders (Settings → Catering). Off by default; the kitchen
  // turns it on and the storefront shows "Catering & large orders".
  cateringEnabled  Boolean @default(false)
  cateringLeadDays Int     @default(3)  // minimum days' notice for an event date
  cateringMinMeals Int     @default(10) // minimum meals on a catering request
  cateringIntro    String? // short pitch on the request page, e.g. "Boxed lunches and trays for offices and events"

  // Storefront search presence (Settings → Brand → Search & link previews).
  // Drive the page <title>/description, link previews and the JSON-LD Google reads.
  storeTagline     String? // one line under the kitchen name, e.g. "Chef-made meal prep, delivered across Durham"
  storeDescription String? // ~160-char search/link-preview description (null = written automatically)
  serviceArea      String? // city/region for local search, e.g. "Mississauga & Oakville"

  // Fulfillment
  cutoff          String   @default("Sat 8:00 PM")
  timezone        String   @default("America/Toronto") // IANA tz the cutoff time is in; powers the storefront countdown
  fulfillment     String   @default("both") // "delivery" | "pickup" | "both"
  deliveryDays    Json     @default("{\"Mon\":true,\"Tue\":false,\"Wed\":true,\"Thu\":false,\"Fri\":true,\"Sat\":false,\"Sun\":false}")
  pickupLocations String[] @default([])

  // Meal-label design: which fields print on the nutrition/allergen labels (both
  // paper and Zebra), plus an optional custom footer line (e.g. "Keep refrigerated").
  labelConfig     Json     @default("{\"showBusinessName\":true,\"showMacros\":true,\"showAllergens\":true,\"showBestBy\":true,\"footer\":\"\"}")

  updatedAt DateTime @updatedAt
}

// Idempotency log for scheduled customer notifications — guarantees the daily
// cron never sends the same reminder twice for the same delivery.
/// Content-Security-Policy violation reports (policy is report-only today).
/// One row per (page path, directive, blocked origin) with a running count, so
/// the operator can see whether the allowlist is clean before enforcing.
model CspReport {
  id           String   @id @default(cuid())
  documentPath String   // pathname of the page that reported (no query string)
  directive    String   // e.g. "script-src-elem"
  blockedUri   String   // origin only (or "inline" / "eval" / "data")
  count        Int      @default(1)
  sample       Json?    // one raw report for debugging
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  @@unique([documentPath, directive, blockedUri])
  @@index([lastSeenAt])
}

model SentNotification {
  id         String   @id @default(cuid())
  businessId String
  type       String // "cutoff" | "delivery_day"
  targetId   String // subscriptionId the reminder is about
  forDate    String // delivery date (YYYY-MM-DD) the reminder concerns
  createdAt  DateTime @default(now())

  @@unique([type, targetId, forDate])
  @@index([businessId])
}

model User {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email          String
  name           String? // set by the owner at invite; used for the dashboard greeting
  role           UserRole @default(owner)
  authProviderId String   @unique // Clerk user id
  createdAt      DateTime @default(now())

  @@unique([businessId, email])
  @@index([businessId])
}

/* ============================== Customers ============================== */

model Customer {
  id               String   @id @default(cuid())
  businessId       String
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name             String
  email            String
  phone            String?
  dietaryPrefs     String[] @default([])
  allergens        String[] @default([])
  loyaltyPoints    Int      @default(0)
  stripeCustomerId String?
  referralCode     String? // this customer's own code to share
  referredById     String? // the customer who referred them (if any)
  createdAt        DateTime @default(now())

  addresses     Address[]
  subscriptions Subscription[]
  orders        Order[]
  reviews       MealReview[]
  referredBy    Customer?  @relation("Referrals", fields: [referredById], references: [id])
  referrals     Customer[] @relation("Referrals")
  cateringRequests CateringRequest[]

  @@unique([businessId, email])
  @@unique([businessId, referralCode])
  @@index([businessId])
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String?
  line1      String
  city       String?
  region     String?
  postalCode String?
  zone       String?

  @@index([customerId])
}

/* ============================== Menu ============================== */

model Meal {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String?
  diet        String?
  priceCents  Int
  swatch      String   @default("#8a5a3c") // fallback card color when there's no photo
  imageUrl    String?  // customer-facing meal photo (Cloudinary secure URL); null = show swatch placeholder
  // Macros
  calories  Int      @default(0)
  proteinG  Int      @default(0)
  carbsG    Int      @default(0)
  fatG      Int      @default(0)
  allergens String[] @default([])
  active    Boolean  @default(true)
  shelfLifeDays Int?  // days the finished meal keeps; drives label "best by" (null = use kitchen default)
  // Checkout add-on: offered in the cart ("Add to your order") when not already in it.
  isAddOn       Boolean @default(false)
  upsellPrompt  String? // optional one-liner shown with the add-on, e.g. "Pairs with any bowl"
  // Recipe yield (food-cost lever #3): servings the recipe is costed for vs. what
  // the kitchen actually gets. If actual < expected, real per-plate cost is higher.
  expectedServings Int? // recipe yield the plate cost assumes
  actualServings   Int? // servings actually produced from that recipe
  // Recipe builder: the cooking method the chef authors, kept with the meal so a
  // retired recipe can be brought back later intact (see the menu "library" view).
  methodSteps      String[] @default([]) // ordered cooking/prep steps
  prepNotes        String? // free-form batch/prep notes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ingredients          MealIngredient[]
  optionGroups         MealOptionGroup[]
  orderItems           OrderItem[]
  subscriptionSelItems SubscriptionSelectionItem[]
  reviews              MealReview[]

  @@index([businessId])
}

// ─── Build-your-own: modifier groups ─────────────────────────────────────────
// A meal can offer option groups ("Base": quinoa | brown rice; "Protein":
// chicken | tofu; "Extras": +avocado, +egg). Each option carries ITS OWN
// ingredient rows and price delta, so a customer's choice flows into plate
// cost, trim-aware purchasing, label macros, and production — no SKU matrix.

model MealOptionGroup {
  id        String @id @default(cuid())
  mealId    String
  meal      Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)
  name      String // "Base", "Protein", "Extras"
  minSelect Int    @default(1) // 0 = optional group
  maxSelect Int    @default(1) // 1 = pick one; >1 = multi-select (add-ons)
  sortOrder Int    @default(0)

  options MealOption[]

  @@index([mealId])
}

model MealOption {
  id              String   @id @default(cuid())
  groupId         String
  group           MealOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name            String // "Quinoa"
  priceDeltaCents Int      @default(0) // added to the meal price (can be 0 or negative)
  isDefault       Boolean  @default(false) // pre-selected; used when no choice is made (POS, subscriptions)
  allergens       String[] @default([])
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)

  ingredients MealOptionIngredient[]

  @@index([groupId])
}

model MealOptionIngredient {
  id           String     @id @default(cuid())
  optionId     String
  option       MealOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  qty          Float
  unit         String
  trimBps      Int        @default(0)

  @@unique([optionId, ingredientId])
  @@index([optionId])
  @@index([ingredientId])
}

// A customer's rating + optional review of a meal (one per customer per meal).
model MealReview {
  id         String   @id @default(cuid())
  businessId String
  mealId     String
  meal       Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating     Int // 1–5
  comment    String?
  // Moderation: reviews are PUBLIC only once approved. New reviews start
  // pending unless the kitchen turns on auto-approve; edits re-enter moderation.
  status     String   @default("pending") // pending | approved | hidden
  reply      String? // the kitchen's public response, shown under the review
  repliedAt  DateTime?
  createdAt  DateTime @default(now())

  @@unique([mealId, customerId])
  @@index([businessId])
  @@index([businessId, status])
  @@index([mealId])
}

model Ingredient {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name             String
  unit             String
  defaultTrimBps   Int      @default(0) // default trim/waste, basis points
  costPerUnitCents Int      @default(0) // purchase cost per `unit`, integer cents (powers the margin/waste engine)
  stockQty         Float    @default(0) // current on-hand quantity, in `unit`
  reorderThreshold Float    @default(0) // low-stock alert threshold (0 = off)
  shelfLifeDays    Int?     // days this ingredient keeps once received (null = not tracked); drives "expiring soon"
  densityGPerMl    Float?   // grams per ml — lets a recipe use a volume unit for an ingredient priced by weight (or vice-versa)
  // Nutrition per the ingredient's unit — lets a meal's macros auto-sum from its recipe.
  calPerUnit     Float @default(0)
  proteinPerUnit Float @default(0)
  carbsPerUnit   Float @default(0)
  fatPerUnit     Float @default(0)

  mealIngredients MealIngredient[]
  optionIngredients MealOptionIngredient[]
  receipts        IngredientReceipt[]
  stockCounts     StockCount[]

  @@unique([businessId, name])
  @@index([businessId])
}

// A logged delivery/purchase of an ingredient. Receiving updates the ingredient's
// on-hand stock and its real cost/unit (from the invoice) — turning the waste
// engine's forecast into measured dollars.
model IngredientReceipt {
  id             String     @id @default(cuid())
  businessId     String // denormalized for tenant isolation (scalar, like Subscription)
  ingredientId   String
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  qtyReceived    Float
  unit           String
  totalCostCents Int
  note           String?
  receivedAt     DateTime   @default(now())

  @@index([businessId])
  @@index([ingredientId])
}

// A physical stock count reconciled against what the system expected on hand.
// The gap (expected − counted) is loss the recipe trim % didn't predict —
// over-trimming, spoilage, or theft — turning forecast waste into measured waste.
model StockCount {
  id            String     @id @default(cuid())
  businessId    String
  ingredientId  String
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  expectedQty   Float
  countedQty    Float
  varianceQty   Float // expected − counted: + is unexplained loss, − is a gain
  varianceCents Int
  countedAt     DateTime   @default(now())

  @@index([businessId])
  @@index([ingredientId])
}

// An explicit, reason-coded food loss: raw ingredient (spoilage, pests) or a
// finished meal (dropped in transit, remade, order error). Unlike StockCount
// variance — which is inferred and undifferentiated — this is intentional and
// categorized, so the P&L can show exactly where margin leaks. Ids are scalar +
// name/cost snapshotted, so a loss stays accurate even if the meal/ingredient is
// later edited or deleted (same philosophy as OrderItem snapshots).
model LossEvent {
  id           String     @id @default(cuid())
  businessId   String
  kind         LossKind
  reason       LossReason
  mealId       String? // set when kind = meal
  ingredientId String? // set when kind = ingredient
  orderId      String? // set when the loss traces to a specific order (dropped/remake/error)
  itemName     String // snapshot of the meal or ingredient name
  qty          Float // meals lost, or ingredient units lost
  unit         String? // ingredient unit; null for meals
  costCents    Int // booked food-cost value of the loss (integer cents)
  restockedFromInventory Boolean @default(false) // true if this decremented ingredient stock
  note         String?
  createdByUserId String?
  createdAt    DateTime   @default(now())

  @@index([businessId])
  @@index([orderId])
  @@index([businessId, createdAt])
}

// A batch of one meal to produce on the line, tracked to done on the KDS board.
// Generated from the production queue when a run is started.
model ProductionTicket {
  id        String       @id @default(cuid())
  businessId String
  mealId    String?
  mealName  String
  station   String
  qty       Int
  status    TicketStatus @default(todo)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([businessId])
}

model MealIngredient {
  id           String     @id @default(cuid())
  mealId       String
  meal         Meal       @relation(fields: [mealId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  qty          Float
  unit         String
  trimBps      Int        @default(0)

  @@unique([mealId, ingredientId])
  @@index([mealId])
  @@index([ingredientId])
}

/* ============================== Plans & Subscriptions ============================== */

model Plan {
  id                String   @id @default(cuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name              String
  mealsPerWeek      Int
  perMealPriceCents Int
  active            Boolean  @default(true)

  subscriptions Subscription[]

  @@index([businessId])
}

model Subscription {
  id                   String       @id @default(cuid())
  businessId           String // denormalized for tenant isolation
  customerId           String
  customer             Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  planId               String
  plan                 Plan         @relation(fields: [planId], references: [id])
  status               SubStatus    @default(active)
  frequency            SubFrequency @default(weekly)
  nextDeliveryDate     DateTime?
  // The weekday(s) this customer receives on — a subset of the kitchen's enabled
  // delivery days (e.g. ["Mon"] or ["Mon","Thu"]). Empty = not chosen; falls back
  // to the kitchen's soonest delivery day. Multiple days split the plan across
  // drops (same price), not a bigger charge.
  preferredDeliveryDays String[]    @default([])
  stripeSubscriptionId String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  selections SubscriptionSelection[]
  orders     Order[]

  @@index([businessId])
  @@index([customerId])
}

model SubscriptionSelection {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  deliveryDate   DateTime

  items SubscriptionSelectionItem[]

  @@unique([subscriptionId, deliveryDate])
  @@index([subscriptionId])
}

model SubscriptionSelectionItem {
  id          String                @id @default(cuid())
  selectionId String
  selection   SubscriptionSelection @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  mealId      String
  meal        Meal                  @relation(fields: [mealId], references: [id])
  qty         Int
  optionsSnapshot Json?
  optionsKey      String?

  @@index([selectionId])
}

/* ============================== Orders ============================== */

model Order {
  id                    String        @id @default(cuid())
  businessId            String
  business              Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId            String?
  customer              Customer?     @relation(fields: [customerId], references: [id])
  subscriptionId        String?
  subscription          Subscription? @relation(fields: [subscriptionId], references: [id])
  type                  OrderType
  status                OrderStatus   @default(pending)
  fulfillment           Fulfillment   @default(delivery)
  address               String?
  zone                  String?
  deliveryDate          DateTime?
  subtotalCents         Int           @default(0)
  taxCents              Int           @default(0)
  feesCents             Int           @default(0)
  totalCents            Int           @default(0)
  giftRedeemedCents     Int           @default(0) // stored-value tender applied at checkout
  stripePaymentIntentId String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  items    OrderItem[]
  payments Payment[]
  delivery Delivery?
  cateringRequest CateringRequest?

  @@index([businessId])
  @@index([customerId])
}

/// A catering / large-order request from the storefront. The kitchen turns it
/// into a quote (items, fee, note); the customer approves and pays through the
/// usual checkout, which creates the Order that then flows into production.
/// Items stay editable JSON until approval, then are snapshotted onto the Order.
model CateringRequest {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  token      String   @unique // unguessable id for the customer's quote link
  status     CateringStatus @default(requested)

  // Who / when / where
  name        String
  email       String
  phone       String?
  company     String?
  eventDate   DateTime // calendar day of the event (noon UTC; shown in the kitchen's tz)
  eventTime   String?  // free text, e.g. "11:30 AM"
  headcount   Int?
  fulfillment Fulfillment @default(delivery)
  address     String?
  notes       String?  // what the customer asked for

  // The quote (owner-edited until approval). items: [{mealId, name, qty, unitPriceCents}]
  items            Json  @default("[]")
  deliveryFeeCents Int   @default(0)
  discountCents    Int   @default(0)
  taxRateBps       Int   @default(0) // snapshot of the kitchen's tax rate when quoted
  ownerNote        String? // message shown on the quote
  declineReason    String?

  quotedAt   DateTime?
  approvedAt DateTime?
  paidAt     DateTime?
  declinedAt DateTime?

  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, status])
  @@index([businessId, eventDate])
}

model OrderItem {
  id                     String  @id @default(cuid())
  orderId                String
  order                  Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  mealId                 String?
  meal                   Meal?   @relation(fields: [mealId], references: [id])
  qty                    Int
  unitPriceCentsSnapshot Int
  nameSnapshot           String
  addedVia               String? // "upsell" when added from the checkout add-on strip (attach-rate analytics)
  // Per-item delivery date — set when a one-time order is split across two
  // delivery days (each meal assigned to a day). Null = the order's single date.
  deliveryDate           DateTime?
  // Build-your-own: the options chosen, frozen at order time ([{groupId, groupName,
  // optionId, optionName, priceDeltaCents}]) + a stable key for grouping identical
  // configurations in production/labels. Null/"" = no options.
  optionsSnapshot        Json?
  optionsKey             String?

  @@index([orderId])
}

/* ============================== Money & marketing ============================== */

model GiftCard {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  code           String
  amountCents    Int
  balanceCents   Int
  recipientEmail String?
  createdAt      DateTime @default(now())

  @@unique([businessId, code])
  @@index([businessId])
}

model Coupon {
  id         String     @id @default(cuid())
  businessId String
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  code       String
  type       CouponType
  value      Int // percent (whole %) for `percent`, cents for `flat`
  active     Boolean    @default(true)

  @@unique([businessId, code])
  @@index([businessId])
}

/* ============================== Payments & delivery ============================== */

model Payment {
  id                    String        @id @default(cuid())
  orderId               String
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stripePaymentIntentId String?
  stripeChargeId        String?
  amountCents           Int
  refundedAmountCents   Int           @default(0)
  status                PaymentStatus @default(pending)
  createdAt             DateTime      @default(now())

  @@index([orderId])
}

model Delivery {
  id          String    @id @default(cuid())
  orderId     String    @unique
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    String?
  externalId  String?
  status      String?
  eta         DateTime?
  trackingUrl String?
  proofUrl    String?
}

/// Recurring monthly operating cost line item — labour or overhead. Feeds the
/// Prime Cost metric (food + labour ≤ 55% of sales) and the true-profit P&L.
model OperatingCost {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  label        String
  category     String   @default("overhead") // "labor" | "overhead"
  monthlyCents Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([businessId])
}


/* ============================== Price intelligence: nearby competitors ============================== */
// A competitor the kitchen chose to watch. We store only public facts: item
// names, listed prices, a link back, and when we last checked. Never
// descriptions or photos, never another PrepFlow tenant's data.

model Competitor {
  id            String   @id @default(cuid())
  businessId    String
  name          String
  domain        String   // bare host, e.g. powerkitchen.ca
  url           String   // where we fetched from
  platform      String?  // how we read them: shopify | woocommerce | jsonld | squarespace | ai | ai-rendered | unsupported
  status        String   @default("ok") // ok | unsupported | error
  lastCheckedAt DateTime?
  lastError     String?
  createdAt     DateTime @default(now())

  items   CompetitorItem[]
  plans   CompetitorPlan[]

  @@unique([businessId, domain])
  @@index([businessId])
}

/// A competitor's published weekly-plan pricing (per-meal price by plan size),
/// kept apart from dish prices so plan-only sellers (CookUnity, Sprwt kitchens)
/// compare against the kitchen's Meal Plans, never against single plates.
model CompetitorPlan {
  id               String     @id @default(cuid())
  competitorId     String
  competitor       Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  mealsPerWeek     Int
  perMealCents     Int
  deliveryFeeCents Int?       // null = not published
  label            String?    // their name for it, e.g. "6 meals / week"
  startingFrom     Boolean    @default(false) // a "from" price or one that varies by postal code
  estimated        Boolean    @default(true)  // read from page text by AI
  url              String?
  active           Boolean    @default(true)
  seenAt           DateTime   @default(now())

  @@unique([competitorId, mealsPerWeek])
  @@index([competitorId])
}

model CompetitorItem {
  id           String     @id @default(cuid())
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  externalId   String     // the store's own id/handle — stable across refreshes
  name         String
  priceCents   Int
  url          String?
  portion      String?    // e.g. "450 g" when the store publishes it
  estimated    Boolean    @default(false) // true when read from page text by AI rather than a structured feed
  active       Boolean    @default(true) // false once it disappears from their menu
  seenAt       DateTime   @default(now())

  matches CompetitorMatch[]

  @@unique([competitorId, externalId])
  @@index([competitorId])
}

// A proposed or confirmed pairing between one of the kitchen's meals and a
// competitor item. Suggestions come from name matching; the owner confirms or
// dismisses, and only confirmed pairs feed the comparison.
model CompetitorMatch {
  id               String         @id @default(cuid())
  businessId       String
  mealId           String
  competitorItemId String
  item             CompetitorItem @relation(fields: [competitorItemId], references: [id], onDelete: Cascade)
  status           String         @default("suggested") // suggested | confirmed | dismissed
  score            Int            @default(0) // 0–100 name-similarity at suggestion time
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([mealId, competitorItemId])
  @@index([businessId, status])
  @@index([mealId])
}
